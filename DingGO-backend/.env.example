# 复制为 .env 后修改：cp .env.example .env
# ⚠ .env 里有密码和密钥，不要提交到 Git、不要发给别人

# 数据库（docker compose 自带 MySQL 时保持 db 这个主机名）
MYSQL_ROOT_PASSWORD=请改成一个复杂的密码
MYSQL_PASSWORD=请改成另一个复杂的密码
DATABASE_URL=mysql+pymysql://dinggo:请改成另一个复杂的密码@db:3306/dinggo?charset=utf8mb4

# 登录凭证签名密钥：随便一串 32 位以上的随机字符
JWT_SECRET=请改成随机字符串

# 小程序
WX_APPID=wxdf1c03b7933a33fa
# 在小程序后台「开发管理 → 开发设置」获取；为空时只能用开发登录
WX_SECRET=
# 开发登录（不校验微信身份，任何人都能登录）：上线前必须改成 false
DEV_LOGIN=true

# 服务器对外地址（生成录音下载链接用），例如 http://47.x.x.x:8000 或 https://api.你的域名.com
PUBLIC_BASE_URL=http://服务器公网IP:8000

# 管理接口令牌（导入分析结果用）：随机字符串；留空则关闭管理接口
ADMIN_TOKEN=

# 识别费用估算（元/小时）：火山 LAS 约 1.6
ASR_PRICE_PER_HOUR=1.6

# ---- AI（录音转写 + 分析）：三项都填了才会启用，否则「确认识别」会提示服务还没配置 ----
# 火山 LAS 语音转写密钥（在火山引擎控制台创建）
LAS_API_KEY=
LAS_REGION=cn-beijing
# 大模型（OpenAI 兼容接口，例如火山方舟）：地址、密钥、模型名
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
# 角色标注 / 有效性判断可以用更便宜的模型；留空则同 LLM_MODEL
ROLE_LLM_MODEL=
# 分析复核：off 关闭 | flagged 只复核有风险的模块（推荐）| all 全部复核（更准但更贵）
REVIEW_MODE=flagged
# 同时处理几条录音；每人每天最多确认多少条
WORKER_THREADS=2
DAILY_VISIT_LIMIT=30
