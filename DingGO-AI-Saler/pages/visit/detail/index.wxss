.page { min-height: 100vh; }
.head { padding: 24rpx 0; }
.store { font-size: 40rpx; font-weight: 700; }
.meta { margin-top: 12rpx; }
.cost-row { padding: 12rpx 0; font-size: 30rpx; }
.price { color: #5b55e8; font-weight: 700; font-size: 36rpx; }
.cost-btns { margin-top: 28rpx; }
.flex1 { flex: 1; }
.rejudge { margin-top: 24rpx; }
.item { padding: 20rpx 0; border-bottom: 2rpx solid #f0f1f6; }
.item:last-child { border-bottom: none; }
.item-title { font-size: 30rpx; font-weight: 600; }
.item-text { font-size: 28rpx; line-height: 1.7; margin: 8rpx 0; }
.quote { background: #f6f6fb; border-radius: 16rpx; padding: 14rpx 20rpx; margin-top: 12rpx; font-size: 26rpx; color: #4a4d6b; line-height: 1.6; }
.ts { color: #5b55e8; margin-right: 8rpx; font-weight: 500; }
.concerns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.concern { border-radius: 20rpx; padding: 20rpx 12rpx; text-align: center; }
.concern.on { background: #eeedfd; color: #5b55e8; }
.concern.off { background: #f6f6fb; color: #a7aac2; }
.concern.unknown { background: #fef3e0; color: #d98a0b; }
.c-name { font-size: 28rpx; font-weight: 600; }
.c-state { font-size: 22rpx; margin-top: 6rpx; }
.legend { margin-top: 16rpx; }
.score-head { gap: 32rpx; margin-bottom: 24rpx; }
.score-side { flex: 1; }
.outcome { margin-top: 16rpx; line-height: 1.6; font-size: 26rpx; }
.dim { margin: 16rpx 0; font-size: 26rpx; }
.bar { height: 12rpx; border-radius: 6rpx; background: #eef0f5; margin-top: 8rpx; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #8f8af0, #5b55e8); border-radius: 6rpx; }
.conclusion { margin-top: 24rpx; background: #f6f6fb; border-radius: 20rpx; padding: 24rpx; line-height: 1.8; font-size: 28rpx; }
.golden { padding: 20rpx 0; }
.golden-text { font-size: 30rpx; font-weight: 600; line-height: 1.7; color: #2d2a9e; margin-bottom: 12rpx; }
.kv { font-size: 26rpx; line-height: 1.7; color: #4a4d6b; }
.k { display: inline-block; width: 140rpx; color: #a7aac2; }
.sub-title { font-size: 28rpx; font-weight: 600; margin: 24rpx 0 12rpx; }
.check { font-size: 28rpx; line-height: 1.8; }
.action { background: #f6f6fb; border-radius: 20rpx; padding: 20rpx 24rpx; margin-bottom: 16rpx; }
.disclaimer { text-align: center; margin: 8rpx 0 24rpx; }
.legend-row { margin-bottom: 20rpx; }
.utt { margin-bottom: 24rpx; display: flex; flex-direction: column; }
.utt.sales { align-items: flex-end; }
.utt-meta { font-size: 22rpx; color: #a7aac2; margin-bottom: 8rpx; }
.utt-bubble { max-width: 560rpx; padding: 20rpx 26rpx; border-radius: 24rpx; font-size: 28rpx; line-height: 1.7; }
.sales .utt-bubble { background: #5b55e8; color: #fff; border-top-right-radius: 6rpx; }
.customer .utt-bubble { background: #fff; border-top-left-radius: 6rpx; }
.other .utt-bubble { background: #eef0f5; color: #6b6f8e; font-size: 26rpx; }
.playing .utt-bubble { box-shadow: 0 0 0 4rpx #f5a623; }

.info-tags { margin-bottom: 12rpx; }
.info-row { font-size: 27rpx; line-height: 1.7; margin-top: 10rpx; color: #4a4d6b; }
.legacy-text { font-size: 27rpx; line-height: 1.8; white-space: pre-wrap; }
.legacy-tip { text-align: left; margin: 0 0 16rpx; }
