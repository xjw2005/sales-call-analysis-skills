<view class="page gradient-bg">
  <!-- 自定义导航 -->
  <view style="height:{{statusBarHeight}}px"></view>
  <view class="nav container row" style="height:{{navHeight}}px">
    <view class="menu" bindtap="toggleDrawer"><view></view><view></view><view class="short"></view></view>
    <text class="nav-title">助手</text>
    <view class="new-chat" style="right:{{navRight}}px" bindtap="newChat"><image src="/assets/icons/new-chat.svg" mode="aspectFit" /></view>
  </view>

  <scroll-view class="chat" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view class="container">
      <!-- 欢迎卡：两个选项 -->
      <view class="hero card">
        <view class="date"><view class="date-m">{{month}}月</view><view class="date-d">{{day}}</view></view>
        <view class="hi">Hi</view>
        <view class="greet">我是<text class="brand">DingGo</text>，你的 AI 销售助手</view>
        <view class="row store-row">
          <text class="faint ctx">当前门店</text>
          <view class="pill" bindtap="switchStore">
            <view class="pill-avatar">店</view>
            <view class="pill-name">{{currentStore ? currentStore.name : '添加门店'}}</view>
            <text class="caret">▾</text>
          </view>
          <view class="pill-add" bindtap="addStore">+</view>
        </view>
        <view wx:if="{{todayHint}}" class="hint">🔔 {{todayHint}}</view>
        <view class="options">
          <view class="option" bindtap="openToday">
            <view class="op-icon" style="background:#3d7cf5">办</view>
            <text>今日待办</text>
            <view wx:if="{{todayCount}}" class="op-badge">{{todayCount}}</view>
          </view>
          <view class="option" bindtap="openPractice">
            <view class="op-icon" style="background:#5b55e8">练</view>
            <text>AI 销售陪练</text>
          </view>
        </view>
      </view>

      <!-- 对话流 -->
      <block wx:for="{{messages}}" wx:key="id" wx:for-item="msg">
        <!-- 用户气泡（阿福样式：右侧紫色） -->
        <view wx:if="{{msg.type === 'user'}}" class="msg user"><view class="bubble">{{msg.text}}</view></view>

        <!-- AI 回答 -->
        <view wx:elif="{{msg.type === 'ai'}}" class="msg ai">
          <view class="bubble"><text user-select>{{msg.text}}</text><view class="ai-note">AI 生成，仅供参考</view></view>
          <view wx:if="{{msg.suggestions.length && index === messages.length - 1}}" class="chips">
            <view wx:for="{{msg.suggestions}}" wx:key="*this" wx:for-item="s" class="chip" data-q="{{s}}" bindtap="tapSuggestion">{{s}}</view>
          </view>
        </view>

        <!-- 新对话的主动问候：今日计划 / 到期约定 / 问今天去哪 -->
        <view wx:elif="{{msg.type === 'greet'}}" class="msg ai">
          <view class="bubble"><text user-select>{{msg.greeting.text}}</text></view>
          <view wx:if="{{msg.greeting.plan.length}}" class="panel plan-panel">
            <view class="panel-body">
              <view class="sec-title">今日计划</view>
              <view wx:for="{{msg.greeting.plan}}" wx:key="id" wx:for-item="p" class="prow">
                <view class="prow-main row">
                  <text class="tag {{p.status === 'visited' ? 'success' : 'info'}} prow-tag">{{p.status === 'visited' ? '已去' : '待去'}}</text>
                  <view class="prow-text"><view class="prow-title">{{p.name}}</view><view class="prow-sub">{{p.reason || p.district}}</view></view>
                  <view wx:if="{{p.status === 'visited'}}" class="prow-btn" data-action="visit" data-id="{{p.visitId}}" bindtap="onPlanAction">看拜访</view>
                  <view wx:else class="prow-btn" data-action="record" data-store="{{p.storeId}}" bindtap="onPlanAction">到店录音</view>
                </view>
              </view>
            </view>
          </view>
          <view class="chips">
            <view wx:for="{{msg.greeting.options}}" wx:key="label" wx:for-item="o" class="chip" data-kind="{{o.kind}}" data-district="{{o.district}}" data-label="{{o.label}}" bindtap="tapOption">{{o.label}}</view>
          </view>
        </view>

        <!-- 候选门店：勾选后确定今日计划 -->
        <view wx:elif="{{msg.type === 'cands'}}" class="msg ai">
          <view class="panel">
            <view class="panel-body cands">
              <view class="sec-title">{{msg.cands.title}}</view>
              <view wx:for="{{msg.cands.items}}" wx:key="storeId" wx:for-item="c" wx:for-index="ci" class="cand row" data-msg="{{msg.id}}" data-i="{{ci}}" bindtap="toggleCand">
                <view class="check {{c.checked ? 'on' : ''}}">{{c.checked ? '✓' : ''}}</view>
                <view class="prow-text">
                  <view class="prow-title">{{c.name}}</view>
                  <view class="prow-sub">{{c.reason}}</view>
                  <view wx:if="{{c.district || c.address}}" class="faint cand-addr">{{c.district}} {{c.address}}</view>
                </view>
              </view>
              <view class="panel-btns row">
                <view wx:if="{{msg.cands.done}}" class="pb">已加入今日计划</view>
                <view wx:else class="pb primary" data-msg="{{msg.id}}" bindtap="confirmCands">确定今日计划</view>
              </view>
            </view>
          </view>
        </view>

        <!-- 今日计划卡片 -->
        <view wx:elif="{{msg.type === 'plan'}}" class="msg ai">
          <view class="panel">
            <view class="panel-body">
              <view class="sec-title">今日计划</view>
              <view wx:for="{{msg.plan}}" wx:key="id" wx:for-item="p" class="prow">
                <view class="prow-main row">
                  <text class="tag {{p.status === 'visited' ? 'success' : 'info'}} prow-tag">{{p.status === 'visited' ? '已去' : '待去'}}</text>
                  <view class="prow-text">
                    <view class="prow-title">{{p.name}}</view>
                    <view class="prow-sub">{{p.reason || p.district}}</view>
                    <view wx:if="{{p.status !== 'visited'}}" class="prow-link" data-action="remove" data-id="{{p.id}}" data-plan="{{msg.id}}" bindtap="onPlanAction">移出计划</view>
                  </view>
                  <view class="prow-col">
                    <view class="prow-btn" data-action="brief" data-store="{{p.storeId}}" bindtap="onPlanAction">简报</view>
                    <view wx:if="{{p.status !== 'visited'}}" class="prow-btn solid" data-action="record" data-store="{{p.storeId}}" bindtap="onPlanAction">到店录音</view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 今日待办大卡片 -->
        <view wx:elif="{{msg.type === 'todo'}}" class="msg ai">
          <view class="panel">
            <view class="panel-head row">
              <view class="ph-icon" style="background:#3d7cf5">办</view>
              <view class="ph-body">
                <view class="ph-title">今日待办</view>
                <view wx:if="{{msg.panel.steps}}" class="ph-steps">
                  <text wx:for="{{msg.panel.steps.labels}}" wx:key="*this" wx:for-item="l" wx:for-index="i" class="ps {{i < msg.panel.steps.current ? 'done' : i === msg.panel.steps.current ? 'now' : ''}}">{{i < msg.panel.steps.current ? '✓' : i + 1}} {{l}}</text>
                </view>
              </view>
              <view class="ph-stat">{{msg.panel.stat}}</view>
            </view>
            <view class="panel-body">
              <view wx:for="{{msg.panel.sections}}" wx:key="title" wx:for-item="sec" class="sec">
                <view class="sec-title">{{sec.title}}</view>
                <view wx:for="{{sec.rows}}" wx:key="key" wx:for-item="r" class="prow">
                  <view class="prow-main row">
                    <text class="tag {{r.tone}} prow-tag">{{r.badge}}</text>
                    <view class="prow-text">
                      <view class="prow-title">{{r.text}}</view>
                      <view class="prow-sub">{{r.sub}}</view>
                      <view wx:if="{{r.subBtn}}" class="prow-link" data-action="{{r.subAction}}" data-id="{{r.id}}" data-msg="{{msg.id}}" bindtap="onRowAction">{{r.subBtn}} ›</view>
                    </view>
                    <view class="prow-btn" data-action="{{r.action}}" data-id="{{r.id}}" data-msg="{{msg.id}}" bindtap="onRowAction">{{r.btn}}</view>
                  </view>
                </view>
              </view>
              <view wx:if="{{!msg.panel.sections.length}}" class="faint empty-tip">今天还没有待办，新建对话告诉我要去哪</view>
              <view class="panel-btns row">
                <view class="pb" data-action="allTodos" data-msg="{{msg.id}}" bindtap="onRowAction">查看全部待办</view>
                <view class="pb primary" data-action="record" data-msg="{{msg.id}}" bindtap="onRowAction">开始拜访录音</view>
              </view>
            </view>
          </view>
          <view wx:if="{{index === messages.length - 1}}" class="chips">
            <view wx:for="{{msg.panel.suggestions}}" wx:key="*this" wx:for-item="s" class="chip" data-q="{{s}}" bindtap="tapSuggestion">{{s}}</view>
          </view>
        </view>

        <!-- AI 陪练入口卡（参考 AI 诊室） -->
        <view wx:elif="{{msg.type === 'practice-intro'}}" class="msg ai">
          <view class="panel">
            <view class="clinic-head row between">
              <text class="clinic-title">AI 销售陪练</text>
              <view wx:if="{{practice}}" class="clinic-exit" bindtap="exitPractice">退出</view>
            </view>
            <view class="panel-body">
              <view class="clinic-steps"><text class="on">01·选场景</text> » <text>02·对练</text> » <text>03·点评</text></view>
              <view class="clinic-intro">我来扮演门店老板，你用下方输入框回答。每个场景 4 轮，结束后给你打分和参考说法。</view>
              <view class="scenarios">
                <view wx:for="{{msg.scenarios}}" wx:key="id" wx:for-item="sc" class="scenario" data-id="{{sc.id}}" data-title="{{sc.title}}" bindtap="pickScenario">
                  <view class="row between"><text class="sc-title">{{sc.title}}</text><text class="tag {{sc.level === '高频' ? 'warn' : sc.level === '入门' ? 'success' : 'info'}}">{{sc.level}}</text></view>
                  <view class="sc-desc">{{sc.desc}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 陪练：老板台词 -->
        <view wx:elif="{{msg.type === 'customer'}}" class="msg ai">
          <view class="who">门店老板 · AI 扮演</view>
          <view class="bubble customer">{{msg.text}}</view>
        </view>

        <!-- 陪练点评 -->
        <view wx:elif="{{msg.type === 'result'}}" class="msg ai">
          <view class="panel">
            <view class="panel-head row">
              <view class="ph-icon" style="background:#5b55e8">评</view>
              <view class="ph-body"><view class="ph-title">陪练点评 · {{msg.result.title}}</view></view>
              <view class="ph-score">{{msg.result.total}}<text class="unit">分</text></view>
            </view>
            <view class="panel-body">
              <view wx:for="{{msg.result.dims}}" wx:key="name" wx:for-item="d" class="dim">
                <view class="row between"><text>{{d.name}}</text><text class="faint">{{d.score}}/{{d.max}}</text></view>
                <view class="bar"><view class="bar-fill" style="width:{{d.score / d.max * 100}}%"></view></view>
                <view class="faint">{{d.comment}}</view>
              </view>
              <view class="sec-title">参考说法</view>
              <view class="quote">“{{msg.result.reference}}”</view>
              <view class="panel-btns row">
                <view class="pb" bindtap="openPractice">换个场景</view>
                <view class="pb primary" data-id="{{msg.result.scenarioId}}" bindtap="againPractice">再练一次</view>
              </view>
            </view>
          </view>
        </view>

        <!-- 分隔线 -->
        <view wx:elif="{{msg.type === 'divider'}}" class="divider">— {{msg.text}} —</view>
      </block>

      <view wx:if="{{thinking}}" class="msg ai"><view class="bubble dots"><view></view><view></view><view></view></view></view>
      <view id="bottom" style="height:24rpx"></view>
    </view>
  </scroll-view>

  <!-- 陪练进行中提示条 -->
  <view wx:if="{{practice}}" class="practice-bar row between">
    <text>🎯 陪练中：{{practice.title}} · 第 {{practice.round}}/{{practice.total}} 轮</text>
    <text class="pb-exit" bindtap="exitPractice">退出</text>
  </view>

  <!-- 底部输入条 -->
  <view class="input-bar row">
    <view class="rec-btn" bindtap="startRecord"><image class="rec-icon" src="/assets/icons/mic.svg" />录音</view>
    <input class="input" value="{{input}}" placeholder="{{placeholder}}" placeholder-class="ph" confirm-type="send" bindinput="onInput" bindconfirm="submit" />
    <view wx:if="{{input}}" class="send" bindtap="submit">发送</view>
    <view wx:else class="plus" bindtap="moreActions">+</view>
  </view>
  <view class="tab-safe"></view>

  <!-- 侧滑抽屉 -->
  <view wx:if="{{drawerOpen}}" class="mask" bindtap="toggleDrawer"></view>
  <view class="drawer {{drawerOpen ? 'open' : ''}}" catchtap="noop">
    <view style="height:{{statusBarHeight + navHeight}}px"></view>
    <view class="drawer-title">功能</view>
    <view class="practice-card row" bindtap="openPractice">
      <view class="pc-icon">练</view>
      <view class="pc-body">
        <view class="pc-title">AI 销售陪练</view>
        <view class="faint">AI 扮演门店老板，练开场和异议应对</view>
      </view>
      <text class="faint">›</text>
    </view>
    <view class="drawer-title">对话记录</view>
    <view wx:for="{{histories}}" wx:key="id" class="drawer-chat row between" data-id="{{item.id}}" bindtap="openHistory">
      <text class="dc-title">💬 {{item.title}}</text>
      <text class="faint">{{item.time}}</text>
    </view>
    <view wx:if="{{!histories.length}}" class="faint">还没有对话</view>
    <view style="height:60rpx"></view>
  </view>
</view>
