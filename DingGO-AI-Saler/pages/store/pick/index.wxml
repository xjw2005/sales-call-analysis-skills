<view class="page">
  <view class="search row"><text class="faint">🔍</text><input class="search-input" focus placeholder="搜索门店名称、地址或平台门店 ID" placeholder-class="ph" bindinput="onSearch" /></view>
  <view class="faint count">共 {{total}} 家</view>
  <view wx:for="{{rows}}" wx:key="id" class="item" data-id="{{item.id}}" bindtap="pick">
    <view class="name">{{item.name}}</view>
    <view class="faint">{{item.city}} {{item.address}}<text wx:if="{{item.lastVisitAt}}"> · 有拜访</text></view>
  </view>
  <view wx:if="{{loaded && !total}}" class="faint none">没有匹配的门店</view>
  <view wx:elif="{{rows.length < total}}" class="faint none">上拉加载更多（{{rows.length}} / {{total}}）</view>
</view>
