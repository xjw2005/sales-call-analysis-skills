<view class="page">
  <!-- 空状态（对应「暂无就诊人」） -->
  <empty-state wx:if="{{loaded && !stores.length}}" title="暂无门店" desc="添加你负责的门店，可为其录音拜访、生成门店档案和跟进行动。" />

  <view wx:else class="container">
    <view class="search row"><text class="faint">🔍</text><input class="search-input" placeholder="搜索门店名称或地址" placeholder-class="ph" bindinput="onSearch" /></view>
    <view wx:for="{{shown}}" wx:key="id" class="card store" data-id="{{item.id}}" bindtap="openStore">
      <view class="row between">
        <view class="row"><view class="pill-avatar small">店</view><text class="name">{{item.name}}</text></view>
        <text class="tag {{item.cooperated ? 'success' : 'muted'}}">{{item.cooperated ? '已合作' : '未合作'}}</text>
      </view>
      <view wx:if="{{item.oneLine}}" class="one-line">{{item.oneLine}}</view>
      <view class="faint">{{item.city}} {{item.address}}</view>
      <view class="faint meta">{{item.lastText}} · 共 {{item.visitCount}} 次拜访</view>
    </view>
    <view wx:if="{{!shown.length}}" class="faint none">没有匹配的门店</view>
  </view>

  <view style="height:140rpx"></view>
  <view class="tab-safe"></view>
  <view class="add-bar">
    <view class="btn-primary" bindtap="addStore">添加门店</view>
  </view>
</view>
