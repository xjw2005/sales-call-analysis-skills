<view class="page">
  <!-- 空状态（对应「暂无就诊人」） -->
  <empty-state wx:if="{{loaded && !stores.length}}" title="暂无门店" desc="添加你负责的门店，可为其录音拜访、生成门店档案和跟进行动。" />

  <view wx:else class="container">
    <view class="search row"><text class="faint">🔍</text><input class="search-input" placeholder="搜索门店名称或地址" placeholder-class="ph" bindinput="onSearch" /><view class="filter-btn {{activeCount ? 'on' : ''}}" bindtap="toggleFilter">筛选{{activeCount ? ' · ' + activeCount : ''}}</view></view>
    <view wx:if="{{filterOpen}}" class="card filters">
      <view class="f-title">合作状态</view>
      <view class="chips"><view wx:for="{{coopOpts}}" wx:key="*this" class="chip {{coop === item ? 'sel' : ''}}" data-v="{{item}}" bindtap="pickCoop">{{item}}</view></view>
      <view class="f-title">拜访情况</view>
      <view class="chips"><view wx:for="{{visitOpts}}" wx:key="key" class="chip {{visit === item.key ? 'sel' : ''}}" data-v="{{item.key}}" bindtap="pickVisit">{{item.label}}</view></view>
      <block wx:if="{{owners.length}}">
        <view class="f-title">负责人</view>
        <view class="chips"><view wx:for="{{owners}}" wx:key="*this" class="chip {{owner === item ? 'sel' : ''}}" data-v="{{item}}" bindtap="pickOwner">{{item}}</view></view>
      </block>
      <view class="f-reset" bindtap="resetFilter">重置</view>
    </view>
    <view class="faint count">共 {{shown.length}} 家</view>
    <view wx:for="{{rows}}" wx:key="id" class="card store" data-id="{{item.id}}" bindtap="openStore">
      <view class="row between">
        <view class="row"><view class="pill-avatar small">店</view><text class="name">{{item.name}}</text></view>
        <text class="tag {{item.coopTone}}">{{item.cooperationStatus}}</text>
      </view>
      <view wx:if="{{item.oneLine}}" class="one-line">{{item.oneLine}}</view>
      <view class="faint">{{item.city}} {{item.address}}<text wx:if="{{owners.length && item.primarySalesName}}"> · {{item.primarySalesName}}</text></view>
      <view class="faint meta">{{item.lastText}} · 共 {{item.visitCount}} 次拜访</view>
    </view>
    <view wx:if="{{!shown.length}}" class="faint none">没有匹配的门店</view>
    <view wx:elif="{{rows.length < shown.length}}" class="faint none">上拉加载更多（已显示 {{rows.length}} / {{shown.length}}）</view>
  </view>

  <view style="height:140rpx"></view>
  <view class="tab-safe"></view>
  <view class="add-bar">
    <view class="btn-primary" bindtap="addStore">添加门店</view>
  </view>
</view>
