<view class="page gradient-bg" wx:if="{{store}}">
  <view class="container">
    <view class="row head">
      <view class="pill"><view class="pill-avatar">店</view><view class="pill-name">{{store.name}}</view></view>
      <text class="tag {{coopTone}} coop">{{store.cooperationStatus}}</text>
    </view>
    <view class="faint addr">{{store.province}}{{store.city}} {{store.address}}</view>

    <!-- 三圆环仪表（对应 精力/饮食/活动） -->
    <view wx:if="{{hasMetrics}}" class="rings row">
      <score-ring value="{{store.metrics.score}}" label="合作进展{{grade ? ' · ' + grade : ''}}" color="#3d7cf5" size="{{190}}" />
      <score-ring value="{{store.metrics.concernHits}}" max="{{9}}" unit="/9" label="关心点" color="#22b07d" size="{{220}}" />
      <score-ring value="{{store.metrics.loopRate}}" unit="%" label="行动闭环" color="#f5a623" size="{{190}}" />
    </view>

    <view wx:else class="faint nometrics">暂无 AI 分析数据，新录音分析后显示合作进展、关心点和行动闭环。</view>

    <view class="segment">
      <view wx:for="{{tabs}}" wx:key="*this" class="segment-item {{tab === index ? 'active' : ''}}" data-i="{{index}}" bindtap="switchTab">{{item}}</view>
    </view>

    <!-- 门店档案：七维度 -->
    <view wx:if="{{tab === 0}}">
      <block wx:if="{{sections.length}}">
        <view class="row between sub-head">
          <text class="faint">累计自 {{store.profile.sourceCount}} 次拜访</text>
          <text class="btn-soft" bindtap="correct">纠正档案</text>
        </view>
        <view wx:if="{{store.correction}}" class="card correction">
          <view class="faint">DSR 纠正（优先级最高）</view>
          <view>{{store.correction}}</view>
        </view>
        <view wx:for="{{sections}}" wx:key="key" class="card section">
          <view class="row between">
            <view class="card-title">{{item.label}}<ai-badge /></view>
            <text class="tag {{item.tone}}">{{item.state}}</text>
          </view>
          <view class="content {{item.state === '未确认' ? 'muted' : ''}}">{{item.content}}</view>
        </view>
      </block>
      <empty-state wx:else compact title="暂无门店档案" desc="完成一次拜访录音分析后自动生成" />
    </view>

    <!-- 拜访记录 -->
    <view wx:if="{{tab === 1}}">
      <visit-card wx:for="{{store.visits}}" wx:key="id" visit="{{item}}" show-store="{{false}}" />
      <empty-state wx:if="{{!store.visits.length}}" compact title="暂无拜访录音" desc="点击下方开始第一次拜访" />
    </view>

    <!-- 行动闭环 -->
    <view wx:if="{{tab === 2}}">
      <block wx:if="{{store.todos.length}}">
        <view class="section-title small">待办事项</view>
        <view wx:for="{{store.todos}}" wx:key="id" class="card">
          <view class="row between"><text class="act-topic">{{item.topic}}</text><text class="tag {{item.done ? 'success' : item.due.tone}}">{{item.done ? '已完成' : (item.dueDate ? item.due.text : '进行中')}}</text></view>
          <view wx:if="{{item.action}}" class="muted act">{{item.action}}</view>
          <view wx:if="{{item.targetQty !== null}}" class="faint">{{item.period}} 目标 {{item.targetQty}}{{item.unit}} · 已达成 {{item.achievedQty || 0}}{{item.unit}}{{item.gapQty !== null ? ' · 差 ' + item.gapQty : ''}}</view>
          <view wx:if="{{item.progressNote}}" class="faint">{{item.progressNote}}</view>
        </view>
      </block>
      <block wx:if="{{store.legacyActions.length}}">
        <view class="section-title small">历史拜访中的行动记录</view>
        <view wx:for="{{store.legacyActions}}" wx:key="visitId" wx:for-item="la" class="card">
          <view class="faint">{{la.time}} · {{la.stage}}</view>
          <view wx:for="{{la.sections}}" wx:key="title" class="loop-item"><view class="act-topic">{{item.title}}</view><view class="muted loop-now">{{item.text}}</view></view>
          <view wx:if="{{!la.sections.length}}" class="faint">这次拜访在飞书里没有行动分析记录</view>
        </view>
      </block>
      <view class="section-title small">当前建议行动</view>
      <view wx:for="{{store.actions}}" wx:key="index" class="card">
        <view class="row between"><text class="act-topic">{{item.topic}}</text><text class="tag primary">{{item.timeframe}}</text></view>
        <view class="muted act">{{item.action}}</view>
        <view class="faint">责任人：{{item.owner}} · 验收：{{item.acceptance}}</view>
      </view>
      <empty-state wx:if="{{!store.actions.length}}" compact title="暂无建议行动" />
      <view class="section-title small">历次闭环</view>
      <view wx:for="{{store.loops}}" wx:key="visitId" wx:for-item="loop" class="card">
        <view class="faint">{{loop.time}}</view>
        <view wx:for="{{loop.items}}" wx:key="index" class="loop-item">
          <view class="row between"><text>{{item.prev}}</text><text class="tag {{item.status === '已完成' ? 'success' : 'warn'}}">{{item.status}}</text></view>
          <view class="muted loop-now">{{item.now}}</view>
        </view>
      </view>
      <view wx:if="{{!store.loops.length}}" class="faint none">日常拜访后会记录上次行动的完成情况</view>
    </view>
  </view>
  <view style="height:200rpx"></view>
  <view class="bottom-bar"><view class="btn-primary" bindtap="record">开始拜访录音</view></view>
</view>
