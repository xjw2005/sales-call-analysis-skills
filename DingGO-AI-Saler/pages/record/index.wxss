.page { min-height: 100vh; }
.title { font-size: 56rpx; font-weight: 800; padding-top: 24rpx; }
.subtitle { display: inline-block; margin: 16rpx 0 24rpx; padding: 8rpx 24rpx; border-radius: 999rpx; background: rgba(255,255,255,0.7); color: #5b55e8; font-size: 24rpx; }
.form { padding: 8rpx 32rpx 24rpx; }
.field { padding: 26rpx 0; border-bottom: 2rpx solid #f0f1f6; font-size: 30rpx; }
.val { font-weight: 500; }
.opt { padding: 8rpx 32rpx; border-radius: 999rpx; background: #f2f3f8; color: #6b6f8e; font-size: 26rpx; }
.opt.on { background: #5b55e8; color: #fff; }
.mode-tip { padding-top: 20rpx; line-height: 1.6; }
.recorder { display: flex; flex-direction: column; align-items: center; padding: 32rpx 0 40rpx; }
.timer { font-size: 88rpx; font-weight: 300; letter-spacing: 4rpx; font-variant-numeric: tabular-nums; }
.rec-state { margin: 8rpx 0 32rpx; }
.rec-btn { width: 200rpx; height: 200rpx; border-radius: 50%; background: rgba(91,85,232,0.15); display: flex; align-items: center; justify-content: center; }
.rec-btn.recording { animation: pulse 1.6s infinite; }
@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(91,85,232,0.35); } 100% { box-shadow: 0 0 0 40rpx rgba(91,85,232,0); } }
.rec-inner { width: 150rpx; height: 150rpx; border-radius: 50%; background: #5b55e8; display: flex; align-items: center; justify-content: center; }
.rec-icon { width: 64rpx; height: 64rpx; }
.pause-icon { display: flex; gap: 16rpx; }
.pause-icon view { width: 14rpx; height: 52rpx; border-radius: 6rpx; background: #fff; }
.play-icon { width: 0; height: 0; border-left: 44rpx solid #fff; border-top: 28rpx solid transparent; border-bottom: 28rpx solid transparent; margin-left: 10rpx; }
.stop { margin-top: 32rpx; }
.link { margin-top: 28rpx; color: #5b55e8; }
.file { font-size: 30rpx; margin-bottom: 16rpx; }
.note { width: 100%; min-height: 120rpx; font-size: 28rpx; line-height: 1.6; }
.ph { color: #a7aac2; }
.steps { justify-content: center; margin-top: 16rpx; color: #a7aac2; font-size: 26rpx; }
.step { display: flex; align-items: center; }
.step.on { color: #1c1b4b; }
.num { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid currentColor; text-align: center; line-height: 34rpx; font-size: 22rpx; margin-right: 10rpx; }
.dash { width: 48rpx; border-top: 2rpx dashed #c9cbdc; margin: 0 16rpx; }
.hint { text-align: center; margin-top: 12rpx; }
