.page { min-height: 100vh; padding-bottom: 60rpx; }
.title { font-size: 52rpx; font-weight: 800; padding-top: 24rpx; }
.subtitle { display: inline-block; margin: 16rpx 0; padding: 8rpx 24rpx; border-radius: 999rpx; background: rgba(255,255,255,0.7); color: #5b55e8; font-size: 24rpx; }
.intro { margin-bottom: 24rpx; }
.sc { gap: 24rpx; }
.sc-icon { width: 80rpx; height: 80rpx; border-radius: 24rpx; background: #eeedfd; color: #5b55e8; font-size: 34rpx; font-weight: 700; text-align: center; line-height: 80rpx; flex-shrink: 0; }
.sc-body { flex: 1; }
.sc-title { font-size: 32rpx; font-weight: 600; }
.sc-desc { margin-top: 8rpx; line-height: 1.6; }
