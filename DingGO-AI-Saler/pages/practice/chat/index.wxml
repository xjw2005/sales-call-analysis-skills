<view class="page">
  <view class="top container row between">
    <view>
      <view class="t-title">{{title}}</view>
      <view class="faint">{{desc}}</view>
    </view>
    <text class="tag primary round">{{finished ? '已结束' : '第 ' + round + '/' + totalRounds + ' 轮'}}</text>
  </view>

  <scroll-view class="chat" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view class="container">
      <view wx:for="{{messages}}" wx:key="id" class="msg {{item.role}}">
        <view class="who faint">{{item.role === 'customer' ? '门店老板（AI 扮演）' : '我'}}</view>
        <view class="bubble">{{item.text}}</view>
      </view>
      <view wx:if="{{waiting}}" class="msg customer"><view class="bubble dots"><view></view><view></view><view></view></view></view>

      <!-- 点评 -->
      <view wx:if="{{finished && !result}}" class="faint center">正在点评…</view>
      <view wx:if="{{result}}" class="card result">
        <view class="row between"><view class="card-title">本次点评</view><text class="score">{{result.total}}<text class="unit">分</text></text></view>
        <view wx:for="{{result.dims}}" wx:key="name" class="dim">
          <view class="row between"><text>{{item.name}}</text><text class="faint">{{item.score}}/{{item.max}}</text></view>
          <view class="bar"><view class="bar-fill" style="width:{{item.score / item.max * 100}}%"></view></view>
          <view class="faint dim-c">{{item.comment}}</view>
        </view>
        <view class="sub">参考说法</view>
        <view class="quote">“{{result.reference}}”</view>
        <view class="faint note">演示版按关键词粗略打分，接入大模型后点评会更准确。</view>
        <view class="row gap btns">
          <view class="btn-ghost flex1" bindtap="other">换个场景</view>
          <view class="btn-primary flex1 small" bindtap="again">再练一次</view>
        </view>
      </view>
      <view id="bottom" style="height:24rpx"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!finished}}" class="input-bar row">
    <input class="input" value="{{input}}" placeholder="你会怎么回答老板？" placeholder-class="ph" confirm-type="send" bindinput="onInput" bindconfirm="submit" />
    <view class="send {{input ? '' : 'off'}}" bindtap="submit">发送</view>
  </view>
  <view wx:if="{{!finished}}" class="faint end" bindtap="endEarly">提前结束</view>
  <view class="safe"></view>
</view>
