<view class="page gradient-bg">
  <view class="container">
    <view class="faint tip">助手会记住你教它的知识、说法和习惯。销量、计划、拜访这些会变的数据，它每次都是现查的，不靠记忆。</view>

    <block wx:if="{{pending.length}}">
      <view class="sec-title">待你确认</view>
      <view wx:for="{{pending}}" wx:key="id" class="card item">
        <view class="text">{{item.text}}</view>
        <view wx:if="{{item.kind === 'fact'}}" class="faint meta">记住后只对你自己生效，没有经过公司核实</view>
        <view class="acts">
          <view class="act-btn" data-id="{{item.id}}" bindtap="remove">不用</view>
          <view class="act-btn primary" data-id="{{item.id}}" bindtap="confirm">记住</view>
        </view>
      </view>
    </block>

    <view class="row between head">
      <text class="faint">已记住</text>
      <text class="link" bindtap="add">+ 教助手</text>
    </view>
    <block wx:for="{{groups}}" wx:key="kind" wx:for-item="g">
      <view class="sec-title">{{g.title}}</view>
      <view wx:if="{{g.note}}" class="faint group-note">{{g.note}}</view>
      <view wx:for="{{g.items}}" wx:key="id" class="card item">
        <view class="row between top">
          <view class="text">{{item.text}}</view>
          <text wx:if="{{item.scope === 'team'}}" class="tag primary">团队通用</text>
        </view>
        <view class="faint meta">{{item.trust === 'model_inferred' ? '助手提议、你确认的' : '你说的'}} · 用过 {{item.hits}} 次</view>
        <view class="row ops">
          <text class="op" data-id="{{item.id}}" data-kind="{{item.kind}}" data-key="{{item.key}}" data-value="{{item.value}}" bindtap="edit">修改</text>
          <text wx:if="{{isManager && item.kind !== 'lesson' && item.kind !== 'fact'}}" class="op" data-id="{{item.id}}" data-scope="{{item.scope}}" bindtap="share">{{item.scope === 'team' ? '取消团队通用' : '设为团队通用'}}</text>
          <text class="op danger" data-id="{{item.id}}" bindtap="remove">删除</text>
        </view>
      </view>
    </block>
    <empty-state wx:if="{{loaded && empty}}" compact title="还没有记住任何东西" desc="和助手聊天时说「记住……」，或点右上的「+ 教助手」：可以教它一条产品知识、一个地区说法或你的习惯。" />

    <block wx:if="{{team.length}}">
      <view class="sec-title">团队通用（上级设置）</view>
      <view wx:for="{{team}}" wx:key="id" class="card item"><view class="text">{{item.text}}</view></view>
    </block>
    <view style="height:60rpx"></view>
  </view>
</view>
