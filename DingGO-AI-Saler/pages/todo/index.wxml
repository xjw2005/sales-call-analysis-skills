<view class="container">
  <view class="segment">
    <view class="segment-item {{tab === 0 ? 'active' : ''}}" data-i="0" bindtap="switchTab">待办 {{open.length}}</view>
    <view class="segment-item {{tab === 1 ? 'active' : ''}}" data-i="1" bindtap="switchTab">已完成 {{done.length}}</view>
  </view>
  <view wx:for="{{tab === 0 ? open : done}}" wx:key="id" class="card todo {{item.done ? 'is-done' : ''}}">
    <view class="row between">
      <text class="store" data-id="{{item.storeId}}" bindtap="openStore">{{item.storeName}} ›</text>
      <text wx:if="{{!item.done}}" class="tag {{item.due.tone}}">{{item.due.text}}</text>
    </view>
    <view class="topic">{{item.topic}}</view>
    <view wx:if="{{item.action}}" class="action">{{item.action}}</view>
    <view wx:if="{{item.hasTarget}}" class="target">
      <view class="row between"><text>目标 {{item.targetQty}}{{item.unit}} · 已达成 {{item.achievedQty || 0}}{{item.unit}}</text><text class="faint">差 {{item.gapQty}}{{item.unit}}</text></view>
      <view class="bar"><view class="bar-fill" style="width:{{item.pct}}%"></view></view>
      <view wx:if="{{item.progressNote}}" class="faint">{{item.progressNote}}</view>
    </view>
    <view wx:if="{{item.acceptance}}" class="faint">验收：{{item.acceptance}}</view>
    <view class="btns row">
      <view wx:if="{{!item.done}}" class="fb" data-id="{{item.id}}" bindtap="copy">复制微信话术</view>
      <view class="{{item.done ? 'fb' : 'fb-primary'}}" data-id="{{item.id}}" data-done="{{item.done}}" bindtap="toggle">{{item.done ? '撤销完成' : '标记完成'}}</view>
    </view>
  </view>
  <empty-state wx:if="{{tab === 0 && !open.length}}" compact title="待办都完成了" desc="拜访分析完成后，建议行动会自动出现在这里" />
  <empty-state wx:if="{{tab === 1 && !done.length}}" compact title="还没有完成的事项" />
</view>
