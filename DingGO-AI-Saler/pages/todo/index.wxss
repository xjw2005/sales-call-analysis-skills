.sec-title { font-size: 28rpx; font-weight: 600; color: #6b6f8e; margin: 28rpx 8rpx 12rpx; }
.store { font-size: 26rpx; color: #5b55e8; }
.topic { font-size: 32rpx; font-weight: 600; margin: 14rpx 0 8rpx; }
.action { font-size: 28rpx; line-height: 1.7; margin-bottom: 8rpx; }
.is-done .topic, .is-done .action { color: #a7aac2; text-decoration: line-through; }

.target { font-size: 27rpx; margin: 12rpx 0; }
.bar { height: 12rpx; border-radius: 6rpx; background: #eef0f5; margin: 10rpx 0; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #8f8af0, #5b55e8); }
