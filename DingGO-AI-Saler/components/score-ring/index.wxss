.ring { border-radius: 50%; padding: 14rpx; box-sizing: border-box; }
.inner { width: 100%; height: 100%; border-radius: 50%; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.num { font-size: 44rpx; font-weight: 700; line-height: 1.1; }
.unit { font-size: 22rpx; font-weight: 500; margin-left: 2rpx; }
.label { font-size: 22rpx; margin-top: 4rpx; }
