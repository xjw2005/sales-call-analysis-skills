.node { display: flex; position: relative; padding-bottom: 28rpx; }
.node:not(:last-child)::after { content: ''; position: absolute; left: 19rpx; top: 44rpx; bottom: 4rpx; width: 2rpx; background: #e1e2ec; }
.node.done:not(:last-child)::after { background: #5b55e8; }
.dot { width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid #d3d5e2; background: #fff; flex-shrink: 0; margin-right: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #fff; box-sizing: border-box; }
.done .dot { background: #5b55e8; border-color: #5b55e8; }
.active .dot { border: 10rpx solid #5b55e8; }
.error .dot { background: #f0544f; border-color: #f0544f; }
.label { font-size: 28rpx; color: #a7aac2; line-height: 40rpx; }
.done .label, .active .label { color: #1c1b4b; }
.active .label { font-weight: 600; }
.error .label { color: #f0544f; font-weight: 600; }
.sub { font-size: 24rpx; color: #6b6f8e; margin-top: 4rpx; }
