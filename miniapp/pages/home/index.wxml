<view class="page gradient-bg">
  <!-- 自定义导航：☰ 助手 [AI 陪练] -->
  <view style="height:{{statusBarHeight}}px"></view>
  <view class="nav container row" style="height:{{navHeight}}px">
    <view class="menu" bindtap="toggleDrawer"><view></view><view></view><view class="short"></view></view>
    <text class="nav-title">助手</text>
    <view class="practice-pill" bindtap="openPractice">🎯 AI 陪练</view>
  </view>

  <scroll-view class="chat" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <view class="container">
      <!-- 欢迎卡 -->
      <view class="hero card">
        <view class="date"><view class="date-m">{{month}}月</view><view class="date-d">{{day}}</view></view>
        <view class="hi">Hi</view>
        <view class="greet">我是你的销售助手</view>
        <view class="row store-row">
          <text class="faint ctx">当前门店</text>
          <view class="pill" bindtap="switchStore">
            <view class="pill-avatar">店</view>
            <view class="pill-name">{{currentStore ? currentStore.name : '添加门店'}}</view>
            <text class="caret">▾</text>
          </view>
          <view class="pill-add" bindtap="addStore">+</view>
        </view>
        <!-- 拜访四步 -->
        <view wx:if="{{steps}}" class="steps">
          <view class="step-row row">
            <block wx:for="{{steps.labels}}" wx:key="*this">
              <view class="step {{index < steps.current ? 'done' : index === steps.current ? 'now' : ''}}">
                <view class="step-dot">{{index < steps.current ? '✓' : index + 1}}</view>
                <view class="step-text">{{item}}</view>
              </view>
              <view wx:if="{{index < steps.labels.length - 1}}" class="step-line {{index < steps.current ? 'done' : ''}}"></view>
            </block>
          </view>
          <view class="step-hint">👉 {{steps.hint}}</view>
        </view>
      </view>

      <!-- 助手主动发的第一条消息 -->
      <view wx:if="{{feed}}" class="msg ai">
        <view class="bubble lead">{{feed.text}}</view>
        <view wx:for="{{feed.cards}}" wx:key="key" class="feed-card {{item.type}}">
          <text class="tag {{item.tone}}">{{item.badge}}</text>
          <view class="feed-title">{{item.title}}</view>
          <view class="feed-desc">{{item.desc}}</view>
          <view class="feed-btns row">
            <view wx:for="{{item.buttons}}" wx:key="text" wx:for-item="b" class="{{b.primary ? 'fb-primary' : 'fb'}}" data-action="{{b.action}}" data-id="{{b.id}}" bindtap="onCardAction">{{b.text}}</view>
          </view>
        </view>
        <view class="faint opt-label">或者，你想：</view>
        <view class="options">
          <view wx:for="{{options}}" wx:key="key" class="btn-soft" data-key="{{item.key}}" bindtap="onOption">{{item.text}}</view>
        </view>
      </view>

      <!-- 问答 -->
      <view wx:for="{{messages}}" wx:key="id" class="msg {{item.role}}">
        <view class="bubble">
          <text user-select>{{item.text}}</text>
          <view wx:if="{{item.role === 'ai'}}" class="ai-note">AI 生成，仅供参考</view>
        </view>
        <view wx:if="{{item.role === 'ai' && item.suggestions.length && index === messages.length - 1}}" class="options">
          <view wx:for="{{item.suggestions}}" wx:key="*this" wx:for-item="s" class="btn-soft" data-q="{{s}}" bindtap="tapSuggestion">{{s}}</view>
        </view>
      </view>
      <view wx:if="{{thinking}}" class="msg ai">
        <view class="bubble dots"><view></view><view></view><view></view></view>
      </view>
      <view id="bottom" style="height:24rpx"></view>
    </view>
  </scroll-view>

  <!-- 底部输入条：录音 + 提问 + 更多 -->
  <view class="input-bar row">
    <view class="rec-btn" bindtap="startRecord"><image class="rec-icon" src="/assets/icons/mic.svg" />录音</view>
    <input class="input" value="{{input}}" placeholder="{{placeholder}}" placeholder-class="ph" confirm-type="send" bindinput="onInput" bindconfirm="submit" />
    <view wx:if="{{input}}" class="send" bindtap="submit">发送</view>
    <view wx:else class="plus" bindtap="moreActions">+</view>
  </view>
  <view class="tab-safe"></view>

  <!-- 侧滑抽屉 -->
  <view wx:if="{{drawerOpen}}" class="mask" bindtap="toggleDrawer"></view>
  <view class="drawer {{drawerOpen ? 'open' : ''}}" catchtap="noop">
    <view style="height:{{statusBarHeight + navHeight}}px"></view>
    <view class="drawer-title">功能</view>
    <view class="practice-card row" bindtap="openPractice">
      <view class="pc-icon">练</view>
      <view class="pc-body">
        <view class="pc-title">AI 销售陪练</view>
        <view class="faint">AI 扮演门店老板，练开场和异议应对</view>
      </view>
      <text class="faint">›</text>
    </view>
    <view class="drawer-title">我的门店</view>
    <view wx:for="{{stores}}" wx:key="id" class="drawer-store row" data-id="{{item.id}}" bindtap="pickStore">
      <view class="pill-avatar small">店</view>
      <text>{{item.name}}</text>
      <text wx:if="{{currentStore && currentStore.id === item.id}}" class="tag primary cur">当前</text>
    </view>
    <view class="drawer-title">对话记录</view>
    <view wx:for="{{histories}}" wx:key="id" class="drawer-chat row between" data-id="{{item.id}}" bindtap="openHistory">
      <text class="dc-title">💬 {{item.title}}</text>
      <text class="faint">{{item.time}}</text>
    </view>
    <view wx:if="{{!histories.length}}" class="faint">还没有对话</view>
    <view style="height:60rpx"></view>
  </view>
</view>
