.page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.nav { gap: 24rpx; flex-shrink: 0; }
.menu { width: 44rpx; }
.menu view { height: 6rpx; border-radius: 3rpx; background: #1c1b4b; margin: 8rpx 0; }
.menu .short { width: 60%; }
.nav-title { font-size: 40rpx; font-weight: 700; }
.new-chat { font-size: 24rpx; color: #5b55e8; background: rgba(255,255,255,0.8); border-radius: 999rpx; padding: 8rpx 20rpx; }
.chat { flex: 1; min-height: 0; }
.banner { background: #fff; border-radius: 32rpx; padding: 24rpx 32rpx; margin: 16rpx 0 24rpx; }
.banner-title { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.banner-arrow { width: 56rpx; height: 56rpx; border-radius: 50%; background: #8f8af0; color: #fff; text-align: center; line-height: 56rpx; }
.hero { position: relative; padding-top: 40rpx; margin-top: 16rpx; }
.avatar { position: absolute; left: 50%; top: -24rpx; transform: translateX(-50%); width: 96rpx; height: 96rpx; border-radius: 50%; background: linear-gradient(135deg, #7b75ff, #5b55e8); color: #fff; font-weight: 700; text-align: center; line-height: 96rpx; box-shadow: 0 8rpx 24rpx rgba(91,85,232,0.3); }
.date { position: absolute; right: 32rpx; top: 32rpx; width: 88rpx; border-radius: 16rpx; overflow: hidden; text-align: center; box-shadow: 0 4rpx 16rpx rgba(91,85,232,0.12); }
.date-m { background: #5b55e8; color: #fff; font-size: 20rpx; padding: 4rpx 0; }
.date-d { background: #fff; font-size: 40rpx; font-weight: 700; padding: 4rpx 0; }
.hi { font-size: 56rpx; font-style: italic; font-weight: 800; color: #2d2a9e; margin-top: 40rpx; }
.greet { font-size: 48rpx; font-weight: 700; color: #2d2a9e; margin: 8rpx 0 16rpx; }
.intro { line-height: 1.7; font-size: 28rpx; }
.store-row { margin: 32rpx 0 8rpx; }
.ctx { margin-right: 16rpx; }
.caret { margin-left: 12rpx; font-size: 22rpx; }
.pill-add { background: #f2f3f8; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 24rpx; }
.grid-item { border: 2rpx solid #ececf4; border-radius: 28rpx; min-height: 104rpx; display: flex; align-items: center; padding: 16rpx 20rpx; font-size: 27rpx; font-weight: 500; box-sizing: border-box; }
.gi-icon { width: 48rpx; height: 48rpx; border-radius: 14rpx; color: #fff; text-align: center; line-height: 48rpx; font-size: 24rpx; margin-right: 14rpx; flex-shrink: 0; }
.gi-0 { background: #3d7cf5; } .gi-1 { background: #5b55e8; } .gi-2 { background: #22b07d; } .gi-3 { background: #f5a623; }

.msg { display: flex; flex-wrap: wrap; margin: 24rpx 0; }
.msg.user { justify-content: flex-end; }
.msg-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #5b55e8; color: #fff; font-size: 22rpx; text-align: center; line-height: 64rpx; margin-right: 16rpx; flex-shrink: 0; }
.bubble { max-width: 560rpx; padding: 22rpx 28rpx; border-radius: 28rpx; font-size: 29rpx; line-height: 1.7; word-break: break-all; }
.user .bubble { background: #5b55e8; color: #fff; border-top-right-radius: 8rpx; }
.ai .bubble { background: #fff; color: #1c1b4b; border-top-left-radius: 8rpx; }
.ai-note { font-size: 20rpx; color: #a7aac2; margin-top: 12rpx; }
.suggest { width: 100%; padding-left: 80rpx; display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.dots { display: flex; gap: 10rpx; align-items: center; height: 40rpx; }
.dots view { width: 12rpx; height: 12rpx; border-radius: 50%; background: #a7aac2; animation: blink 1s infinite; }
.dots view:nth-child(2) { animation-delay: 0.2s; } .dots view:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

.input-bar { flex-shrink: 0; margin: 12rpx 32rpx 0; height: 104rpx; background: #fff; border-radius: 52rpx; padding: 0 12rpx; box-shadow: 0 8rpx 32rpx rgba(28,27,75,0.08); }
.rec-btn { display: flex; align-items: center; background: #5b55e8; color: #fff; border-radius: 999rpx; height: 76rpx; padding: 0 24rpx 0 16rpx; font-size: 26rpx; flex-shrink: 0; }
.rec-icon { width: 36rpx; height: 36rpx; margin-right: 6rpx; }
.input { flex: 1; margin: 0 16rpx; font-size: 28rpx; }
.ph { color: #a7aac2; }
.plus { width: 72rpx; height: 72rpx; line-height: 68rpx; text-align: center; font-size: 48rpx; color: #1c1b4b; }
.send { background: #eeedfd; color: #5b55e8; border-radius: 999rpx; padding: 14rpx 28rpx; font-size: 26rpx; }

.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(28,27,75,0.35); z-index: 10; }
.drawer { position: fixed; top: 0; bottom: 0; left: 0; width: 600rpx; background: #fff; z-index: 11; transform: translateX(-100%); transition: transform 0.25s; padding: 0 40rpx; box-sizing: border-box; overflow-y: auto; }
.drawer.open { transform: translateX(0); }
.drawer-title { font-size: 40rpx; font-weight: 700; margin: 40rpx 0 20rpx; }
.drawer-store { padding: 16rpx 0; font-size: 30rpx; gap: 16rpx; }
.pill-avatar.small { width: 56rpx; height: 56rpx; line-height: 56rpx; background: #eeedfd; color: #5b55e8; margin-right: 0; }
.cur { margin-left: auto; }
.drawer-chat { padding: 18rpx 0; font-size: 28rpx; }
.dc-title { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-right: 16rpx; }
