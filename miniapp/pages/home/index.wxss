.page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.nav { gap: 24rpx; flex-shrink: 0; }
.menu { width: 44rpx; }
.menu view { height: 6rpx; border-radius: 3rpx; background: #1c1b4b; margin: 8rpx 0; }
.menu .short { width: 60%; }
.nav-title { font-size: 40rpx; font-weight: 700; }
.practice-pill { font-size: 24rpx; color: #5b55e8; background: rgba(255,255,255,0.85); border-radius: 999rpx; padding: 8rpx 22rpx; }
.chat { flex: 1; min-height: 0; }

.hero { position: relative; margin-top: 16rpx; }
.date { position: absolute; right: 32rpx; top: 32rpx; width: 88rpx; border-radius: 16rpx; overflow: hidden; text-align: center; box-shadow: 0 4rpx 16rpx rgba(91,85,232,0.12); }
.date-m { background: #5b55e8; color: #fff; font-size: 20rpx; padding: 4rpx 0; }
.date-d { background: #fff; font-size: 40rpx; font-weight: 700; padding: 4rpx 0; }
.hi { font-size: 56rpx; font-style: italic; font-weight: 800; color: #2d2a9e; }
.greet { font-size: 44rpx; font-weight: 700; color: #2d2a9e; margin: 4rpx 0 8rpx; }
.store-row { margin: 24rpx 0 8rpx; }
.ctx { margin-right: 16rpx; }
.caret { margin-left: 12rpx; font-size: 22rpx; }
.pill-add { background: #f2f3f8; }

.steps { margin-top: 28rpx; background: #f6f6fb; border-radius: 24rpx; padding: 24rpx 20rpx 20rpx; }
.step-row { align-items: flex-start; }
.step { width: 120rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.step-dot { width: 44rpx; height: 44rpx; border-radius: 50%; background: #e1e2ec; color: #a7aac2; font-size: 22rpx; text-align: center; line-height: 44rpx; }
.step.done .step-dot { background: #5b55e8; color: #fff; }
.step.now .step-dot { background: #fff; color: #5b55e8; box-shadow: 0 0 0 4rpx #5b55e8; font-weight: 700; }
.step-text { font-size: 20rpx; color: #a7aac2; margin-top: 10rpx; text-align: center; }
.step.done .step-text, .step.now .step-text { color: #1c1b4b; }
.step.now .step-text { font-weight: 600; }
.step-line { flex: 1; height: 4rpx; background: #e1e2ec; margin-top: 20rpx; border-radius: 2rpx; }
.step-line.done { background: #5b55e8; }
.step-hint { margin-top: 18rpx; font-size: 26rpx; color: #5b55e8; }

.msg { display: flex; flex-direction: column; margin: 24rpx 0; }
.msg.user { align-items: flex-end; }
.msg.ai { align-items: flex-start; }
.bubble { max-width: 600rpx; padding: 22rpx 28rpx; border-radius: 28rpx; font-size: 29rpx; line-height: 1.7; word-break: break-all; }
.user .bubble { background: #5b55e8; color: #fff; border-top-right-radius: 8rpx; }
.ai .bubble { background: #fff; color: #1c1b4b; border-top-left-radius: 8rpx; }
.bubble.lead { font-weight: 500; }
.ai-note { font-size: 20rpx; color: #a7aac2; margin-top: 12rpx; }

.feed-card { align-self: stretch; background: #fff; border-radius: 28rpx; padding: 24rpx 28rpx; margin-top: 16rpx; }
.feed-card.todo { border-left: 8rpx solid #f0544f; }
.feed-card.review { border-left: 8rpx solid #5b55e8; }
.feed-title { font-size: 30rpx; font-weight: 600; margin: 14rpx 0 8rpx; line-height: 1.5; }
.feed-desc { font-size: 26rpx; color: #6b6f8e; line-height: 1.7; }
.feed-btns { justify-content: flex-end; gap: 16rpx; margin-top: 20rpx; flex-wrap: wrap; }
.fb { padding: 10rpx 26rpx; border-radius: 999rpx; border: 2rpx solid #e1e2ec; font-size: 25rpx; color: #4a4d6b; }
.fb-primary { padding: 10rpx 26rpx; border-radius: 999rpx; background: #5b55e8; color: #fff; font-size: 25rpx; border: 2rpx solid #5b55e8; }
.opt-label { margin: 24rpx 0 12rpx; }
.options { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.opt-label + .options { margin-top: 0; }
.dots { display: flex; gap: 10rpx; align-items: center; height: 40rpx; }
.dots view { width: 12rpx; height: 12rpx; border-radius: 50%; background: #a7aac2; animation: blink 1s infinite; }
.dots view:nth-child(2) { animation-delay: 0.2s; } .dots view:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

.input-bar { flex-shrink: 0; margin: 12rpx 32rpx 0; height: 104rpx; background: #fff; border-radius: 52rpx; padding: 0 12rpx; box-shadow: 0 8rpx 32rpx rgba(28,27,75,0.08); }
.rec-btn { display: flex; align-items: center; background: #5b55e8; color: #fff; border-radius: 999rpx; height: 76rpx; padding: 0 24rpx 0 16rpx; font-size: 26rpx; flex-shrink: 0; }
.rec-icon { width: 36rpx; height: 36rpx; margin-right: 6rpx; }
.input { flex: 1; margin: 0 16rpx; font-size: 28rpx; }
.ph { color: #a7aac2; }
.plus { width: 72rpx; height: 72rpx; line-height: 68rpx; text-align: center; font-size: 48rpx; color: #1c1b4b; }
.send { background: #eeedfd; color: #5b55e8; border-radius: 999rpx; padding: 14rpx 28rpx; font-size: 26rpx; }

/* 抽屉层级高于页面内所有独立渲染层；打开时另行隐藏自定义标签栏 */
.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(28,27,75,0.35); z-index: 1000; }
.drawer { position: fixed; top: 0; bottom: 0; left: 0; width: 600rpx; background: #fff; z-index: 1001; transform: translateX(-100%); transition: transform 0.25s; padding: 0 40rpx; box-sizing: border-box; overflow-y: auto; }
.drawer.open { transform: translateX(0); }
.drawer-title { font-size: 40rpx; font-weight: 700; margin: 40rpx 0 20rpx; }
.practice-card { background: linear-gradient(135deg, #eeedfd, #e6f6ff); border-radius: 28rpx; padding: 24rpx; gap: 20rpx; }
.pc-icon { width: 80rpx; height: 80rpx; border-radius: 24rpx; background: #5b55e8; color: #fff; font-weight: 700; text-align: center; line-height: 80rpx; flex-shrink: 0; }
.pc-body { flex: 1; }
.pc-title { font-size: 30rpx; font-weight: 600; margin-bottom: 4rpx; }
.drawer-store { padding: 16rpx 0; font-size: 30rpx; gap: 16rpx; }
.pill-avatar.small { width: 56rpx; height: 56rpx; line-height: 56rpx; background: #eeedfd; color: #5b55e8; margin-right: 0; }
.cur { margin-left: auto; }
.drawer-chat { padding: 18rpx 0; font-size: 28rpx; }
.dc-title { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-right: 16rpx; }
