.page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
.nav { gap: 24rpx; flex-shrink: 0; }
.menu { width: 44rpx; }
.menu view { height: 6rpx; border-radius: 3rpx; background: #1c1b4b; margin: 8rpx 0; }
.menu .short { width: 60%; }
.nav-title { font-size: 40rpx; font-weight: 700; }
.chat { flex: 1; min-height: 0; }

/* 欢迎卡 */
.hero { position: relative; margin-top: 16rpx; }
.date { position: absolute; right: 32rpx; top: 32rpx; width: 88rpx; border-radius: 16rpx; overflow: hidden; text-align: center; box-shadow: 0 4rpx 16rpx rgba(91,85,232,0.12); }
.date-m { background: #5b55e8; color: #fff; font-size: 20rpx; padding: 4rpx 0; }
.date-d { background: #fff; font-size: 40rpx; font-weight: 700; padding: 4rpx 0; }
.hi { font-size: 56rpx; font-style: italic; font-weight: 800; color: #2d2a9e; }
.greet { font-size: 44rpx; font-weight: 700; color: #2d2a9e; margin: 4rpx 0 8rpx; }
.store-row { margin: 24rpx 0 8rpx; }
.ctx { margin-right: 16rpx; }
.caret { margin-left: 12rpx; font-size: 22rpx; }
.pill-add { background: #f2f3f8; }
.hint { margin-top: 24rpx; font-size: 26rpx; color: #5b55e8; background: #f3f2fe; border-radius: 16rpx; padding: 14rpx 20rpx; }
.options { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 24rpx; }
.option { position: relative; border: 2rpx solid #ececf4; border-radius: 28rpx; height: 112rpx; display: flex; align-items: center; padding: 0 24rpx; font-size: 30rpx; font-weight: 600; }
.op-icon { width: 52rpx; height: 52rpx; border-radius: 16rpx; color: #fff; font-size: 26rpx; text-align: center; line-height: 52rpx; margin-right: 16rpx; }
.op-badge { position: absolute; top: -12rpx; right: -8rpx; min-width: 36rpx; height: 36rpx; padding: 0 10rpx; border-radius: 18rpx; background: #f0544f; color: #fff; font-size: 22rpx; line-height: 36rpx; text-align: center; box-sizing: border-box; }

/* 消息 */
.msg { display: flex; flex-direction: column; margin: 24rpx 0; }
.msg.user { align-items: flex-end; }
.msg.ai { align-items: flex-start; }
.bubble { max-width: 600rpx; padding: 22rpx 28rpx; border-radius: 28rpx; font-size: 29rpx; line-height: 1.7; word-break: break-all; }
.user .bubble { background: linear-gradient(135deg, #6c67f0, #4f7bf5); color: #fff; font-size: 32rpx; font-weight: 600; border-top-right-radius: 8rpx; }
.ai .bubble { background: #fff; color: #1c1b4b; border-top-left-radius: 8rpx; }
.bubble.customer { background: #fff; }
.who { font-size: 22rpx; color: #a7aac2; margin-bottom: 8rpx; }
.ai-note { font-size: 20rpx; color: #a7aac2; margin-top: 12rpx; }
.chips { display: flex; flex-direction: column; align-items: flex-start; gap: 16rpx; margin-top: 20rpx; }
.chip { background: #fff; border-radius: 999rpx; padding: 18rpx 32rpx; font-size: 28rpx; color: #1c1b4b; }
.divider { text-align: center; color: #a7aac2; font-size: 26rpx; margin: 32rpx 0; }
.dots { display: flex; gap: 10rpx; align-items: center; height: 40rpx; }
.dots view { width: 12rpx; height: 12rpx; border-radius: 50%; background: #a7aac2; animation: blink 1s infinite; }
.dots view:nth-child(2) { animation-delay: 0.2s; } .dots view:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }

/* 大卡片（参考阿福「报告解读」卡） */
.panel { align-self: stretch; background: rgba(255,255,255,0.6); border-radius: 36rpx; overflow: hidden; border: 2rpx solid #fff; }
.panel-head { padding: 28rpx 28rpx 20rpx; gap: 20rpx; align-items: flex-start; }
.ph-icon { width: 80rpx; height: 80rpx; border-radius: 50%; color: #fff; font-weight: 700; font-size: 30rpx; text-align: center; line-height: 80rpx; flex-shrink: 0; box-shadow: 0 6rpx 16rpx rgba(61,124,245,0.3); }
.ph-body { flex: 1; min-width: 0; }
.ph-title { font-size: 36rpx; font-weight: 700; }
.ph-steps { margin-top: 10rpx; display: flex; flex-wrap: wrap; gap: 6rpx 14rpx; }
.ps { font-size: 20rpx; color: #a7aac2; }
.ps.done { color: #5b55e8; }
.ps.now { color: #fff; background: #5b55e8; border-radius: 999rpx; padding: 0 12rpx; }
.ph-stat { font-size: 24rpx; color: #f0544f; font-weight: 600; flex-shrink: 0; margin-top: 8rpx; }
.ph-score { font-size: 52rpx; font-weight: 800; color: #5b55e8; flex-shrink: 0; }
.unit { font-size: 22rpx; margin-left: 4rpx; }
.panel-body { position: relative; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 20rpx 28rpx 28rpx; }
.sec { padding: 12rpx 0; border-bottom: 2rpx dashed #eceef5; }
.sec:last-of-type { border-bottom: none; }
.sec-title { font-size: 24rpx; color: #a7aac2; margin: 8rpx 0; }
.prow { padding: 10rpx 0; }
.prow-main { align-items: flex-start; gap: 16rpx; }
.prow-tag { flex-shrink: 0; margin-top: 4rpx; }
.prow-text { flex: 1; min-width: 0; }
.prow-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.prow-sub { font-size: 24rpx; color: #6b6f8e; line-height: 1.5; margin-top: 2rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.prow-link { font-size: 24rpx; color: #5b55e8; margin-top: 6rpx; }
.prow-btn { flex-shrink: 0; font-size: 24rpx; color: #5b55e8; border: 2rpx solid #cfcdfa; border-radius: 999rpx; padding: 8rpx 22rpx; margin-top: 2rpx; }
.empty-tip { text-align: center; padding: 24rpx; }
.panel-btns { gap: 20rpx; margin-top: 24rpx; }
.pb { flex: 1; text-align: center; height: 80rpx; line-height: 76rpx; border-radius: 999rpx; border: 2rpx solid #cfcdfa; color: #5b55e8; font-size: 28rpx; }
.pb.primary { background: #5b55e8; color: #fff; border-color: #5b55e8; }

/* 陪练卡（参考 AI 诊室） */
.clinic-head { background: #5b55e8; padding: 28rpx 32rpx 56rpx; margin-bottom: -32rpx; }
.clinic-title { color: #fff; font-size: 38rpx; font-weight: 700; }
.clinic-exit { color: #fff; border: 2rpx solid rgba(255,255,255,0.6); border-radius: 999rpx; padding: 6rpx 28rpx; font-size: 26rpx; }
.clinic-steps { font-size: 26rpx; color: #a7aac2; padding-bottom: 16rpx; border-bottom: 4rpx dashed #eceef5; }
.clinic-steps .on { color: #1c1b4b; font-weight: 600; }
.clinic-intro { font-size: 28rpx; line-height: 1.7; margin: 20rpx 0; }
.scenarios { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.scenario { background: #f6f6fb; border-radius: 24rpx; padding: 20rpx; }
.sc-title { font-size: 28rpx; font-weight: 600; }
.sc-desc { font-size: 22rpx; color: #6b6f8e; line-height: 1.5; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.dim { margin: 14rpx 0; font-size: 26rpx; }
.bar { height: 12rpx; border-radius: 6rpx; background: #eef0f5; margin: 8rpx 0; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #8f8af0, #5b55e8); }
.quote { background: #f6f6fb; border-radius: 20rpx; padding: 20rpx 24rpx; font-size: 28rpx; line-height: 1.7; color: #2d2a9e; }

/* 陪练状态条 + 输入条 */
.practice-bar { flex-shrink: 0; margin: 8rpx 32rpx 0; background: #eeedfd; color: #5b55e8; border-radius: 20rpx; padding: 14rpx 24rpx; font-size: 24rpx; }
.pb-exit { font-weight: 600; }
.input-bar { flex-shrink: 0; margin: 12rpx 32rpx 0; height: 104rpx; background: #fff; border-radius: 52rpx; padding: 0 12rpx; box-shadow: 0 8rpx 32rpx rgba(28,27,75,0.08); }
.rec-btn { display: flex; align-items: center; background: #5b55e8; color: #fff; border-radius: 999rpx; height: 76rpx; padding: 0 24rpx 0 16rpx; font-size: 26rpx; flex-shrink: 0; }
.rec-icon { width: 36rpx; height: 36rpx; margin-right: 6rpx; }
.input { flex: 1; margin: 0 16rpx; font-size: 28rpx; }
.ph { color: #a7aac2; }
.plus { width: 72rpx; height: 72rpx; line-height: 68rpx; text-align: center; font-size: 48rpx; color: #1c1b4b; }
.send { background: #eeedfd; color: #5b55e8; border-radius: 999rpx; padding: 14rpx 28rpx; font-size: 26rpx; }

/* 抽屉：层级高于页面内所有独立渲染层；打开时另行隐藏自定义标签栏 */
.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(28,27,75,0.35); z-index: 1000; }
.drawer { position: fixed; top: 0; bottom: 0; left: 0; width: 600rpx; background: #fff; z-index: 1001; transform: translateX(-100%); transition: transform 0.25s; padding: 0 40rpx; box-sizing: border-box; overflow-y: auto; }
.drawer.open { transform: translateX(0); }
.drawer-title { font-size: 40rpx; font-weight: 700; margin: 40rpx 0 20rpx; }
.practice-card { background: linear-gradient(135deg, #eeedfd, #e6f6ff); border-radius: 28rpx; padding: 24rpx; gap: 20rpx; }
.pc-icon { width: 80rpx; height: 80rpx; border-radius: 24rpx; background: #5b55e8; color: #fff; font-weight: 700; text-align: center; line-height: 80rpx; flex-shrink: 0; }
.pc-body { flex: 1; }
.pc-title { font-size: 30rpx; font-weight: 600; margin-bottom: 4rpx; }
.drawer-store { padding: 16rpx 0; font-size: 30rpx; gap: 16rpx; }
.pill-avatar.small { width: 56rpx; height: 56rpx; line-height: 56rpx; background: #eeedfd; color: #5b55e8; margin-right: 0; }
.cur { margin-left: auto; }
.drawer-chat { padding: 18rpx 0; font-size: 28rpx; }
.dc-title { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; margin-right: 16rpx; }
