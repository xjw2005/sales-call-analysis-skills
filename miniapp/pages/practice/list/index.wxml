<view class="page gradient-bg">
  <view class="container">
    <view class="title">AI 销售陪练</view>
    <view class="subtitle">AI 扮演门店老板 · 说完给你打分和参考话术</view>
    <view class="faint intro">选一个场景开始。每个场景 4 轮对话，大约 3 分钟。</view>
    <view wx:for="{{scenarios}}" wx:key="id" class="card sc row" data-id="{{item.id}}" bindtap="open">
      <view class="sc-icon">{{index + 1}}</view>
      <view class="sc-body">
        <view class="row gap"><text class="sc-title">{{item.title}}</text><text class="tag {{item.level === '高频' ? 'warn' : item.level === '入门' ? 'success' : 'info'}}">{{item.level}}</text></view>
        <view class="faint sc-desc">{{item.desc}}</view>
      </view>
      <text class="faint">›</text>
    </view>
  </view>
</view>
