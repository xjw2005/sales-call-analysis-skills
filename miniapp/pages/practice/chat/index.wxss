.page { height: 100vh; display: flex; flex-direction: column; background: #f2f3f8; }
.top { padding-top: 20rpx; padding-bottom: 20rpx; background: linear-gradient(180deg, #e3e0ff, #f2f3f8); flex-shrink: 0; gap: 20rpx; }
.t-title { font-size: 34rpx; font-weight: 700; margin-bottom: 6rpx; }
.round { flex-shrink: 0; }
.chat { flex: 1; min-height: 0; }
.msg { display: flex; flex-direction: column; margin: 20rpx 0; }
.msg.sales { align-items: flex-end; }
.who { margin-bottom: 8rpx; }
.bubble { max-width: 560rpx; padding: 20rpx 26rpx; border-radius: 26rpx; font-size: 29rpx; line-height: 1.7; }
.customer .bubble { background: #fff; border-top-left-radius: 8rpx; }
.sales .bubble { background: #5b55e8; color: #fff; border-top-right-radius: 8rpx; }
.dots { display: flex; gap: 10rpx; align-items: center; height: 40rpx; }
.dots view { width: 12rpx; height: 12rpx; border-radius: 50%; background: #a7aac2; }
.center { text-align: center; padding: 24rpx; }
.result { margin-top: 24rpx; }
.score { font-size: 56rpx; font-weight: 800; color: #5b55e8; }
.unit { font-size: 24rpx; margin-left: 4rpx; }
.dim { margin: 18rpx 0; font-size: 28rpx; }
.bar { height: 12rpx; border-radius: 6rpx; background: #eef0f5; margin: 8rpx 0; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #8f8af0, #5b55e8); }
.dim-c { line-height: 1.5; }
.sub { font-size: 28rpx; font-weight: 600; margin: 24rpx 0 12rpx; }
.quote { background: #f6f6fb; border-radius: 20rpx; padding: 20rpx 24rpx; font-size: 28rpx; line-height: 1.7; color: #2d2a9e; }
.note { margin-top: 16rpx; }
.btns { margin-top: 28rpx; }
.flex1 { flex: 1; }
.btn-primary.small { height: 80rpx; line-height: 80rpx; font-size: 28rpx; }
.input-bar { flex-shrink: 0; margin: 12rpx 32rpx 0; height: 100rpx; background: #fff; border-radius: 50rpx; padding: 0 12rpx 0 32rpx; box-shadow: 0 8rpx 32rpx rgba(28,27,75,0.08); }
.input { flex: 1; font-size: 28rpx; }
.ph { color: #a7aac2; }
.send { background: #5b55e8; color: #fff; border-radius: 999rpx; padding: 16rpx 32rpx; font-size: 26rpx; }
.send.off { opacity: 0.4; }
.end { text-align: center; padding: 16rpx 0 0; }
.safe { height: calc(16rpx + env(safe-area-inset-bottom)); flex-shrink: 0; }
