<view class="page gradient-bg" wx:if="{{visit}}">
  <view class="container">
    <!-- 头部 -->
    <view class="head">
      <view class="row between">
        <text class="store">{{visit.storeName}}</text>
        <text class="tag {{status.tone}}">{{status.text}}</text>
      </view>
      <view class="row gap meta">
        <text class="tag {{visit.mode === 'first' ? 'primary' : 'muted'}}">{{visit.stage}}</text>
        <text class="faint">{{visit.time}} · 录音 {{visit.dur}}</text>
      </view>
    </view>

    <!-- 处理进度（对应流程图） -->
    <view class="card">
      <view class="row between" bindtap="toggleTimeline">
        <view class="card-title">处理进度</view>
        <text class="faint">{{showTimeline ? '收起' : '展开'}}</text>
      </view>
      <status-timeline wx:if="{{showTimeline}}" visit="{{visit}}" />
    </view>

    <!-- 费用确认 -->
    <view wx:if="{{visit.status === 'cost_pending'}}" class="card cost">
      <view class="card-title">确认识别费用</view>
      <view class="row between cost-row"><text class="muted">录音时长</text><text>{{visit.dur}}</text></view>
      <view class="row between cost-row"><text class="muted">预估识别费用</text><text class="price">¥{{visit.estCost}}</text></view>
      <view class="faint">确认后将进行语音识别、对话整理和 AI 分析（{{visit.mode === 'first' ? '首访 7 个模块' : '日常 4 个模块'}}）。</view>
      <view class="row gap cost-btns">
        <view class="btn-ghost flex1" bindtap="later">暂不识别</view>
        <view class="btn-primary flex1" bindtap="confirm">确认识别</view>
      </view>
    </view>

    <!-- 无效录音 -->
    <view wx:if="{{visit.status === 'invalid_short' || visit.status === 'invalid_content'}}" class="card">
      <empty-state compact title="{{visit.status === 'invalid_short' ? '录音过短' : '内容无效'}}" desc="{{visit.status === 'invalid_short' ? '有效对话不足 120 秒，未进行分析。' : '未识别到有效的销售对话，未进行分析。'}}">
        <view class="btn-ghost rejudge" bindtap="rejudge">重新判定</view>
      </empty-state>
    </view>

    <!-- 分析结果 -->
    <block wx:if="{{a}}">
      <view class="segment">
        <view wx:for="{{tabs}}" wx:key="*this" class="segment-item {{tab === index ? 'active' : ''}}" data-i="{{index}}" bindtap="switchTab">{{item}}</view>
      </view>

      <!-- 洞察 -->
      <block wx:if="{{tabs[tab] === '洞察'}}">
        <view class="card">
          <view class="card-title">显性需求<ai-badge /></view>
          <view wx:for="{{a.explicitNeeds}}" wx:key="index" class="item">
            <view class="item-title">{{index + 1}}. {{item.point}}</view>
            <view class="muted item-text">{{item.explanation}}</view>
            <view class="faint">场景：{{item.scene}}</view>
            <view wx:for="{{item.evidence}}" wx:key="uid" wx:for-item="e" class="quote" data-ms="{{e.startMs}}" data-uid="{{e.uid}}" bindtap="seek">
              <text class="ts">▶ {{e.ts}}</text>「{{e.text}}」
            </view>
          </view>
          <view wx:if="{{!a.explicitNeeds.length}}" class="faint">本次未提取到显性需求</view>
        </view>

        <view wx:if="{{visit.mode === 'first'}}" class="card">
          <view class="card-title">隐性需求<ai-badge /></view>
          <view wx:for="{{a.implicitNeeds}}" wx:key="index" class="item">
            <view class="row between"><text class="item-title">{{item.hypothesis}}</text><text class="tag {{item.tone}}">可信度{{item.confidence}}</text></view>
            <view class="muted item-text">依据：{{item.basis}}</view>
            <view class="muted item-text">推断：{{item.logic}}</view>
            <view wx:for="{{item.evidence}}" wx:key="uid" wx:for-item="e" class="quote" data-ms="{{e.startMs}}" data-uid="{{e.uid}}" bindtap="seek">
              <text class="ts">▶ {{e.ts}}</text>「{{e.text}}」
            </view>
          </view>
          <view wx:if="{{!a.implicitNeeds.length}}" class="faint">本次未推断出隐性需求</view>
        </view>

        <view class="card">
          <view class="card-title">客户关心点<ai-badge /></view>
          <view class="concerns">
            <view wx:for="{{a.concerns}}" wx:key="name" class="concern {{item.tone}}">
              <view class="c-name">{{item.name}}</view>
              <view class="c-state">{{item.state}}</view>
            </view>
          </view>
          <view class="faint legend">是 = 客户有相关表达；证据不足 = 录音或角色无法确认</view>
        </view>
      </block>

      <!-- 话术（仅首访） -->
      <block wx:if="{{tabs[tab] === '话术'}}">
        <view class="card">
          <view class="card-title">合作进展评分<ai-badge /></view>
          <view class="row score-head">
            <score-ring value="{{a.effectiveness.total}}" label="总分" size="{{200}}" />
            <view class="score-side">
              <view class="row gap"><text class="grade {{grade}}">{{grade}}</text><text class="muted">等级</text></view>
              <view class="muted outcome">{{a.effectiveness.outcome}}</view>
            </view>
          </view>
          <view wx:for="{{a.effectiveness.dims}}" wx:key="name" class="dim">
            <view class="row between"><text>{{item.name}}</text><text class="faint">{{item.score}}/{{item.max}}</text></view>
            <view class="bar"><view class="bar-fill" style="width:{{item.score / item.max * 100}}%"></view></view>
          </view>
          <view class="conclusion">{{a.effectiveness.conclusion}}</view>
        </view>

        <view class="card">
          <view class="card-title">销售金句<ai-badge /></view>
          <view wx:for="{{a.quotes}}" wx:key="index" class="golden">
            <view class="golden-text">“{{item.text}}”</view>
            <view class="kv"><text class="k">场景</text>{{item.scene}}</view>
            <view class="kv"><text class="k">针对问题</text>{{item.problem}}</view>
            <view class="kv"><text class="k">表达方法</text>{{item.method}}</view>
            <view class="kv"><text class="k">表达价值</text>{{item.value}}</view>
            <view wx:if="{{item.reaction}}" class="kv"><text class="k">客户反应</text>{{item.reaction}}</view>
            <view wx:for="{{item.evidence}}" wx:key="uid" wx:for-item="e" class="quote" data-ms="{{e.startMs}}" data-uid="{{e.uid}}" bindtap="seek"><text class="ts">▶ {{e.ts}}</text>原话</view>
          </view>
          <view wx:if="{{!a.quotes.length}}" class="faint">本次未提取到金句</view>
        </view>
      </block>

      <!-- 行动 -->
      <block wx:if="{{tabs[tab] === '行动'}}">
        <view wx:if="{{a.loop}}" class="card">
          <view class="card-title">上次行动闭环<ai-badge /></view>
          <view wx:for="{{a.loop.items}}" wx:key="index" class="item">
            <view class="row between"><text class="item-title">{{item.prev}}</text><text class="tag {{item.status === '已完成' ? 'success' : 'warn'}}">{{item.status}}</text></view>
            <view class="muted item-text">{{item.now}}</view>
          </view>
          <view wx:if="{{!a.loop.items.length}}" class="faint">没有上一次行动记录</view>
        </view>
        <view class="card">
          <view class="row between">
            <view class="card-title">下一步行动<ai-badge /></view>
            <text class="tag {{a.nextAction.judgement === '触发' ? 'primary' : 'muted'}}">{{a.nextAction.judgement}}</text>
          </view>
          <view class="muted item-text">{{a.nextAction.reason}}</view>
          <view wx:if="{{a.nextAction.confirmed.length}}" class="sub-title">已确认的后续事项</view>
          <view wx:for="{{a.nextAction.confirmed}}" wx:key="*this" class="check">☐ {{item}}</view>
          <view class="sub-title">建议行动</view>
          <view wx:for="{{a.nextAction.actions}}" wx:key="index" class="action">
            <view class="row between"><text class="item-title">{{item.topic}}</text><text class="tag primary">{{item.timeframe}}</text></view>
            <view class="item-text">{{item.action}}</view>
            <view class="faint">原因：{{item.reason}}</view>
            <view class="faint">责任人：{{item.owner}} · 验收：{{item.acceptance}}</view>
          </view>
          <view wx:if="{{a.nextAction.revisitValue}}" class="sub-title">二次拜访价值</view>
          <view wx:if="{{a.nextAction.revisitValue}}" class="item-text">{{a.nextAction.revisitValue}}</view>
        </view>
        <view class="faint disclaimer">行动建议为 AI 跟进参考，不作为考核或追责依据。</view>
      </block>

      <!-- 对话 -->
      <block wx:if="{{tabs[tab] === '对话'}}">
        <view class="legend-row row gap"><text class="tag primary">销售</text><text class="tag info">客户</text><text class="tag muted">旁人</text><text class="faint">点击时间可跳播</text></view>
        <view wx:for="{{transcript}}" wx:key="uid" class="utt {{item.role === '销售' ? 'sales' : item.role === '客户' ? 'customer' : 'other'}} {{playingUid === item.uid ? 'playing' : ''}}">
          <view class="utt-meta" data-ms="{{item.startMs}}" data-uid="{{item.uid}}" bindtap="seek">{{item.role}} · ▶ {{item.ts}}</view>
          <view class="utt-bubble"><text user-select>{{item.text}}</text></view>
        </view>
      </block>
    </block>
  </view>
  <view style="height:80rpx"></view>
</view>
