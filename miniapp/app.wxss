/* 设计 token：参考支付宝「阿福」的紫色系 */
page {
  --primary: #5b55e8;
  --primary-light: #eeedfd;
  --bg: #f2f3f8;
  --card: #ffffff;
  --text: #1c1b4b;
  --text-2: #6b6f8e;
  --text-3: #a7aac2;
  --success: #22b07d;
  --warn: #f5a623;
  --error: #f0544f;
  --info: #3d7cf5;
  --radius: 24rpx;
  --radius-lg: 32rpx;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.gradient-bg { background: linear-gradient(180deg, #e3e0ff 0%, #e6f6ff 45%, var(--bg) 100%); }
.container { padding: 0 32rpx; }
.card { background: var(--card); border-radius: var(--radius-lg); padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 24rpx rgba(91, 85, 232, 0.05); }
.card-title { font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; display: flex; align-items: center; }
.card-title::before { content: ''; width: 8rpx; height: 32rpx; border-radius: 4rpx; background: var(--primary); margin-right: 16rpx; }
.section-title { font-size: 34rpx; font-weight: 600; margin: 32rpx 0 20rpx; }
.muted { color: var(--text-2); }
.faint { color: var(--text-3); font-size: 24rpx; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.wrap { flex-wrap: wrap; }
.gap { gap: 16rpx; }

.btn-primary { background: var(--primary); color: #fff; border-radius: 999rpx; height: 96rpx; line-height: 96rpx; text-align: center; font-size: 32rpx; font-weight: 500; }
.btn-primary.disabled { opacity: 0.4; }
.btn-ghost { border: 2rpx solid var(--primary); color: var(--primary); border-radius: 999rpx; height: 80rpx; line-height: 76rpx; text-align: center; padding: 0 40rpx; font-size: 28rpx; }
.btn-soft { background: var(--primary-light); color: var(--primary); border-radius: 999rpx; padding: 12rpx 28rpx; font-size: 26rpx; display: inline-block; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom)); background: linear-gradient(180deg, rgba(242,243,248,0) 0%, var(--bg) 30%); }

.tag { display: inline-block; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; line-height: 1.5; }
.tag.success { background: #e3f6ef; color: var(--success); }
.tag.warn { background: #fef3e0; color: #d98a0b; }
.tag.error { background: #fde8e7; color: var(--error); }
.tag.info { background: #e6eefe; color: var(--info); }
.tag.muted { background: #eef0f5; color: var(--text-2); }
.tag.primary { background: var(--primary-light); color: var(--primary); }

.grade { display: inline-block; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 12rpx; color: #fff; font-weight: 700; font-size: 26rpx; }
.grade.A { background: var(--success); }
.grade.B { background: var(--info); }
.grade.C { background: var(--warn); }
.grade.D { background: var(--error); }

.segment { display: flex; background: rgba(255,255,255,0.7); border-radius: 999rpx; padding: 8rpx; margin: 24rpx 0; }
.segment-item { flex: 1; text-align: center; height: 72rpx; line-height: 72rpx; border-radius: 999rpx; color: var(--text); font-size: 28rpx; }
.segment-item.active { background: var(--primary); color: #fff; font-weight: 600; }

.pill { display: inline-flex; align-items: center; background: var(--primary); color: #fff; border-radius: 999rpx; padding: 12rpx 28rpx 12rpx 12rpx; font-size: 28rpx; max-width: 440rpx; }
.pill-avatar { width: 56rpx; height: 56rpx; border-radius: 50%; background: #fff; color: var(--primary); text-align: center; line-height: 56rpx; margin-right: 16rpx; font-size: 28rpx; flex-shrink: 0; }
.pill-name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.pill-add { width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(255,255,255,0.85); color: var(--text); text-align: center; line-height: 76rpx; font-size: 44rpx; margin-left: 20rpx; }

.tab-safe { height: calc(180rpx + env(safe-area-inset-bottom)); }
