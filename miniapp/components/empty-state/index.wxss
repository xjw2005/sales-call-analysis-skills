.empty { display: flex; flex-direction: column; align-items: center; padding: 200rpx 64rpx 0; text-align: center; }
.empty.compact { padding: 48rpx 32rpx; }
.img { width: 320rpx; height: 260rpx; }
.compact .img { width: 220rpx; height: 180rpx; }
.title { font-size: 40rpx; font-weight: 700; color: #1c1b4b; margin-top: 32rpx; }
.compact .title { font-size: 32rpx; margin-top: 16rpx; }
.desc { font-size: 28rpx; color: #8a8eab; line-height: 1.7; margin-top: 16rpx; }
